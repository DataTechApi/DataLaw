# ============================================================
#  DataLaw — Terraform · GCP · terraform.tfvars.example
#  Copie este arquivo para terraform.tfvars e preencha os valores.
#  ATENÇÃO: NÃO versione o terraform.tfvars — ele já está no .gitignore.
# ============================================================

project_id  = "meu-projeto-gcp-123456"   # gcloud config get-value project
project     = "datalaw"
environment = "prod"
region      = "southamerica-east1"
zone        = "southamerica-east1-b"

# ─── VMs ───────────────────────────────────────────────────
# Mínimo:    e2-small  (2 vCPU / 2 GB) → ~$12/mês cada
# Recomendado: e2-medium (2 vCPU / 4 GB) → ~$34/mês cada
vm_frontend_type = "e2-medium"
vm_backend_type  = "e2-medium"
vm_admin_user    = "datalaw"

# Gere com: ssh-keygen -t ed25519 -C "datalaw-deploy"
# Depois: cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... datalaw-deploy"

# ─── Cloud SQL ─────────────────────────────────────────────
# Mínimo:    db-f1-micro (0.6 GB) → ~$21/mês
# Recomendado: db-g1-small (1.7 GB) → ~$36/mês
db_tier           = "db-g1-small"
db_name           = "datalaw_db"
db_admin_user     = "datalaw"
db_admin_password = "TROQUE_ESTA_SENHA_FORTE_123!"

# ─── Aplicação ─────────────────────────────────────────────
datajud_api_key = "cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw=="
